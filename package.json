{
  "name": "cuv-marketplace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "22.x",
    "pnpm": "10.11.0"
  },
  "scripts": {
    "build": "corepack pnpm --filter @marketplace/api db:generate && corepack pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "env:check": "corepack pnpm --filter @marketplace/config env:check",
    "db:validate": "corepack pnpm --filter @marketplace/api db:validate",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm build && corepack pnpm typecheck && corepack pnpm test && corepack pnpm db:validate",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.15.3",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
