{
  "name": "@marketplace/api",
  "private": true,
  "scripts": {
    "db:validate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js validate",
    "db:migrate:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate",
    "db:seed": "node --env-file-if-exists=../../.env dist/prisma/seed.js",
    "db:studio": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js studio",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "test": "node --test dist/test/password.test.js",
    "test:integration": "node --env-file-if-exists=../../.env --test dist/test/*.integration.js",
    "db:seed:demo": "node --env-file-if-exists=../../.env dist/prisma/seed-demo.js",
    "worker:mail": "node --env-file-if-exists=../../.env dist/src/engagement/mail.worker.js"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6",
    "@marketplace/config": "workspace:*",
    "@marketplace/inventory": "workspace:*",
    "sharp": "0.35.5"
  }
}
